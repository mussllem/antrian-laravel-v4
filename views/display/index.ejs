<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Layar Antrian</title>
    <style>
        *{box-sizing:border-box}
        body{margin:0;font-family:system-ui,Segoe UI,Roboto,Arial,sans-serif;background:#dbe3e7;color:#fff;overflow:hidden}
        .queue-screen{min-height:100vh;padding:clamp(12px,2.2vw,34px);background:radial-gradient(circle at 50% -30%,#fff 0,#e9eff1 36%,#bdc8cd 100%)}
        .queue-board{max-width:1400px;min-height:calc(100vh - clamp(24px,4.4vw,68px));margin:auto;padding:clamp(8px,1vw,16px);border:4px solid #26333a;border-radius:5px;background:#edf3f4;box-shadow:0 16px 34px rgba(8,26,36,.38)}
        .display-head{height:clamp(68px,10vh,118px);display:flex;justify-content:space-between;align-items:center;padding:10px clamp(16px,2.5vw,38px);color:#17242d;background:linear-gradient(90deg,#fff 0 48%,#f5a243 66%,#9d3e16 82%,#15222a 100%);border-bottom:5px solid #32424a}
        .brand{display:flex;align-items:center;gap:12px;font-weight:800;line-height:1}.brand-mark{position:relative;width:44px;height:44px}.brand-mark i{position:absolute;width:19px;height:19px;border-radius:50%;background:#f0a125}.brand-mark i:nth-child(1){left:1px;top:2px}.brand-mark i:nth-child(2){right:0;top:0;background:#0d85be}.brand-mark i:nth-child(3){left:12px;bottom:0;background:#233f75;border-radius:12px 12px 15px 15px;transform:rotate(-25deg)}.brand-name{font-size:clamp(17px,2vw,26px);letter-spacing:-1px}.brand-tagline{font-size:10px;letter-spacing:1.3px;color:#d18a20;margin-top:5px}
        .clock{min-width:180px;text-align:right;color:#fff;font-variant-numeric:tabular-nums}.clock-time{font-size:clamp(22px,3vw,42px);font-weight:800}.clock-date{font-size:clamp(10px,1.2vw,15px);color:#ffe54b;font-weight:700}
        .display-content{display:grid;grid-template-columns:minmax(270px,.85fr) minmax(420px,1.35fr);gap:clamp(10px,1.5vw,20px);padding:clamp(10px,1.5vw,20px);background:#dae6e8}
        .current-call{display:grid;grid-template-rows:1fr 1.35fr;gap:12px;min-height:clamp(270px,50vh,580px)}
        .call-counter,.call-number{display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center;border:3px solid #ddeaf0;box-shadow:inset 0 0 0 3px #114b73,0 4px 8px rgba(0,0,0,.32)}
        .call-counter{background:linear-gradient(#078dc7,#005080);font-size:clamp(34px,5vw,70px);font-weight:900;text-shadow:2px 3px #00314c}.call-caption{font-size:clamp(18px,2vw,30px);font-weight:900;text-transform:uppercase;color:#fff;text-shadow:2px 2px #19262d}.call-number{background:#111c21}.number-label{font-size:clamp(18px,2.2vw,31px);font-weight:900;text-transform:uppercase;color:#fff;text-shadow:2px 2px #010508}.number-code{font-size:clamp(65px,10vw,150px);font-weight:900;line-height:1;color:#ffd925;text-shadow:3px 4px #564600}.service-name{font-size:clamp(12px,1.3vw,18px);color:#a9c4d4;margin-top:5px}
        .visual-panel{position:relative;overflow:hidden;min-height:clamp(270px,50vh,580px);border:3px solid #fff;background:linear-gradient(160deg,#83d4ef 0 43%,#c4f2f5 43% 46%,#1fa5ae 46% 58%,#e5e7bd 58% 64%,#76ad65 64%);box-shadow:0 3px 7px rgba(0,0,0,.34)}.visual-panel:before{content:'';position:absolute;width:75%;height:20%;right:-10%;top:12%;background:radial-gradient(ellipse at center,rgba(255,255,255,.95) 0 18%,transparent 20%),radial-gradient(ellipse at center,rgba(255,255,255,.86) 0 20%,transparent 22%);filter:blur(5px);opacity:.8}.visual-panel:after{content:'LAYANAN ANTRIAN';position:absolute;inset:auto 0 0;padding:20px;background:linear-gradient(transparent,rgba(2,36,54,.76));font-size:clamp(24px,3vw,48px);font-weight:900;letter-spacing:2px;text-align:center;text-shadow:2px 3px #06324a}.visual-copy{position:absolute;top:8%;left:7%;z-index:1;max-width:48%;font-size:clamp(17px,2vw,30px);font-weight:800;color:#075c83;text-shadow:0 1px #fff}.visual-copy small{display:block;margin-top:9px;font-size:clamp(11px,1.2vw,17px);line-height:1.4;color:#164d61;font-weight:600}.display-video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:2}.visual-panel:has(.display-video):after{z-index:3}.visual-panel:has(.display-video):before{display:none}
        .counter-strip{display:grid;grid-template-columns:repeat(auto-fit,minmax(125px,1fr));margin:0 clamp(10px,1.5vw,20px);border:3px solid #f4f6f7;border-bottom:0;background:#006497}.mini-counter{min-width:0;text-align:center;padding:8px 6px;background:linear-gradient(#078dc7,#006596);border-right:3px solid #1c2f38}.mini-counter:last-child{border-right:0}.mini-name{font-size:clamp(10px,1.1vw,16px);font-weight:900;text-transform:uppercase}.mini-code{color:#ffe528;font-size:clamp(20px,2.5vw,38px);font-weight:900;line-height:1;text-shadow:1px 2px #775f00}.mini-counter.flash{animation:flash 1s ease-in-out 3}@keyframes flash{50%{background:#e6a519;color:#15232b}}
        .ticker{display:flex;overflow:hidden;margin:0 clamp(10px,1.5vw,20px);padding:8px 0;background:#111b20;border:3px solid #f4f6f7;color:#ffe928;font-size:clamp(16px,1.7vw,25px);font-weight:800;white-space:nowrap}.ticker span{display:inline-block;padding-left:100%;animation:ticker 23s linear infinite}@keyframes ticker{to{transform:translateX(-100%)}}
        .enable-audio{position:fixed;inset:0;background:rgba(1,16,25,.88);display:flex;align-items:center;justify-content:center;z-index:99}
        .btn{display:inline-block;border:0;border-radius:10px;padding:10px 16px;font-weight:700;cursor:pointer;color:#fff;background:#2563eb}
        .btn.green{background:#22c55e}
        @media(max-width:700px){body{overflow:auto}.queue-screen{padding:0}.queue-board{min-height:100vh;border:0}.display-head{height:76px}.display-content{grid-template-columns:1fr}.visual-panel{display:none}.current-call{min-height:340px}.clock{min-width:120px}.counter-strip{grid-template-columns:repeat(3,1fr)}}
    </style>
</head>
<body>
<div class="enable-audio" id="enableAudio">
    <button class="btn green" style="font-size:22px;padding:22px 34px" onclick="enableAudio()">
        ▶ Klik untuk mengaktifkan suara
    </button>
</div>

<main class="queue-screen">
    <section class="queue-board">
        <header class="display-head">
            <div class="brand" aria-label="Logo layanan">
                <span class="brand-mark"><i></i><i></i><i></i></span>
                <div>
                    <div class="brand-name"><%= settings.company_name %></div>
                    <div class="brand-tagline"><%= settings.tagline %></div>
                </div>
            </div>
            <div class="clock" id="clock"></div>
        </header>
        <div class="display-content">
            <section class="current-call" id="currentCall">
                <div class="call-counter"><span class="call-caption" id="currentCounter">MENUNGGU PANGGILAN</span></div>
                <div class="call-number">
                    <span class="number-label">Nomor Antrian</span>
                    <span class="number-code" id="currentCode">—</span>
                    <span class="service-name" id="currentService">Silakan menunggu nomor Anda dipanggil</span>
                </div>
            </section>
            <aside class="visual-panel">
                <% if (settings.video_source) { %>
                    <video class="display-video" autoplay muted loop playsinline>
                        <source src="<%= settings.video_source %>">
                    </video>
                <% } else { %>
                    <div class="visual-copy">
                        Selamat datang
                        <small>Informasi panggilan antrean ditampilkan secara real-time.</small>
                    </div>
                <% } %>
            </aside>
        </div>
        <section class="counter-strip" id="counterStrip"></section>
        <footer class="ticker"><span id="tickerText"><%= settings.running_text %></span></footer>
    </section>
</main>

<script src="/js/queue-audio.js"></script>
<script>
const player = new QueueAudio('/audio');
let audioEnabled = false;

function enableAudio(){
    audioEnabled = true;
    document.getElementById('enableAudio').style.display = 'none';
    // "unlock" audio di browser dgn memutar bell tanpa suara
    player.announce({ code_digits: [], counter_number: null });
}

function tickClock(){
    const d = new Date();
    document.getElementById('clock').innerHTML = '<div class="clock-time">' + d.toLocaleTimeString('id-ID') + '</div><div class="clock-date">' + d.toLocaleDateString('id-ID',{day:'2-digit',month:'long',year:'numeric'}) + '</div>';
}
setInterval(tickClock, 1000); tickClock();

async function refresh(){
    try {
        const res = await fetch('/display/state');
        const data = await res.json();
        const current = data.last || (data.active && data.active[0]);
        document.getElementById('currentCounter').textContent = current ? (current.counter_name || ('Loket ' + current.counter_number)) : 'MENUNGGU PANGGILAN';
        document.getElementById('currentCode').textContent = (current && current.code) ? current.code : '—';
        document.getElementById('currentService').textContent = current ? 'Silakan menuju loket yang dituju' : 'Silakan menunggu nomor Anda dipanggil';
        const counters = (data.counters && data.counters.length) ? data.counters : (data.active ? data.active.map(a => ({name:a.counter_name, number:a.counter_number, code:a.code})) : []);
        document.getElementById('counterStrip').innerHTML = counters.map(c => '<div class="mini-counter" data-counter="' + c.number + '"><div class="mini-name">' + (c.name || ('Loket ' + c.number)) + '</div><div class="mini-code">' + (c.code || '—') + '</div></div>').join('');
    } catch (e) {
        console.warn('Refresh error:', e);
    }
}
refresh();

// Real-time via Server-Sent Events (SSE)
try {
    const es = new EventSource('/events');
    es.addEventListener('ticket.called', function(e) {
        const payload = JSON.parse(e.data);
        refresh();
        const card = document.querySelector('[data-counter="' + payload.counter_number + '"]');
        if (card){
            card.classList.add('flash');
            setTimeout(() => card.classList.remove('flash'), 3000);
        }
        if (audioEnabled && payload.audio){
            player.announce(payload.audio);
        }
    });
    es.addEventListener('queue.updated', function() {
        refresh();
    });
} catch(e) {
    console.warn('SSE not supported or failed, relying on polling:', e);
}

// Fallback polling interval
setInterval(refresh, 3000);
</script>
</body>
</html>
